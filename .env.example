DATABASE_PATH=./vora.db
# Required for research runs: absolute path to your Chromium executable.
VORA_BROWSER_BINARY=
VORA_HEADLESS=true
VORA_NAVIGATION_TIMEOUT_MS=30000
VORA_NETWORK_IDLE_TIMEOUT_MS=5000
VORA_MAX_NETWORK_RECORDS=500
# Search results kept per batch, and usable pages read per batch (pages with no
# data do not count). Unread candidates are queued for later batches.
VORA_MAX_CANDIDATES=40
VORA_MAX_SOURCES=8
VORA_PORT=8000
VORA_API_KEY=
# Who may call the API: supabase (signed-in users' access tokens), api_key or none.
# Empty means api_key when VORA_API_KEY is set, else none.
VORA_AUTH=
# Supabase project URL (public), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Only for older projects that sign tokens with a shared secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Web origins allowed to call the API from a browser, comma separated
# (the Cloudflare Pages site, and http://localhost:5173 for local development).
VORA_CORS_ORIGINS=
# Supabase user id that owns tracks created before sign-in existed.
VORA_LEGACY_OWNER=
# Official portals read directly when a request names them (see README, "Source registry").
VORA_SOURCE_REGISTRY=data/sources.json
# Pages of a registry listing read on a track's first run; later runs stop at known records.
VORA_RECIPE_MAX_PAGES=5
# Use HTTP/1.1 only: some government servers break form postbacks over HTTP/2.
VORA_HTTP1=true

# Primary text/structured model and optional fallback.
LLM_MODEL=groq/qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=45
# After a model fails or times out, skip it for this many seconds and use the fallback.
LLM_COOLDOWN_SECONDS=600


# Ask the configured model about table headers the semantic lexicon cannot
# place (bounded and cached). Set to false for fully deterministic scoring.
VORA_SEMANTIC_LLM=true
# Live tracks start a batch this many seconds after the previous batch started.
VORA_LIVE_INTERVAL_SECONDS=300
# Work budget of one batch in seconds; pages not reached are queued for the next.
VORA_BATCH_SECONDS=300
# Batches reuse search results this young (minutes) while unread candidates remain.
VORA_SEARCH_CACHE_MINUTES=60
# Browser searches are rationed so engines do not treat us as a bot: an engine that
# blocked us rests (doubling on repeat blocks), searches are spaced, and capped hourly.
VORA_SEARCH_COOLDOWN_MINUTES=15
VORA_SEARCH_INTERVAL_SECONDS=5
VORA_MAX_SEARCHES_PER_HOUR=30
# Optional official search API, used before browser searches. Search engines often
# answer automated browser searches (especially from a stock headless browser) with
# a challenge or with unrelated results; an API avoids that.
#   brave:  Brave Search API key
#   google: Google Programmable Search API key + search engine id (CX)
VORA_SEARCH_API=
VORA_SEARCH_API_KEY=
VORA_SEARCH_API_CX=
# Seconds planning waits for the language model before planning deterministically.
VORA_LLM_PLAN_SECONDS=20
# Machine-readable datasets (CSV) downloaded per run from links on rendered pages.
VORA_MAX_LINKED_DATASETS=2
# Source ranking, rotation and merging (see docs/VORA_WORKFLOW.md §4.2b).
VORA_MAX_PER_DOMAIN=1
VORA_REVISIT_HOURS=24
VORA_BLOCK_COOLDOWN_DAYS=7
VORA_MERGE_RUNS=true
VORA_MAX_RAW_OBSERVATIONS=5000
VORA_SITE_ADAPTERS=true
# Interactive pass beside the fast pass: scroll, tabs, "load more", further pages,
# iframes and the JSON/CSV a page's charts load. Uses a second browser process.
VORA_DEEP_LANE=true
# Skip the interactive pass (its second browser) when less memory than this is free (MB).
VORA_DEEP_LANE_MIN_FREE_MB=1500
# Do not download images, video, audio or fonts (extraction never uses them).
VORA_BLOCK_MEDIA=true
# Launch browsers with fewer background services (about 20% less memory each).
VORA_LEAN_BROWSER=true
# Batches (tracks) working at once, and the browsers they share (one page per browser at a
# time; about 400 MB each). More tracks than this simply wait their turn.
VORA_MAX_CONCURRENT_BATCHES=4
VORA_BROWSER_POOL=2
# A browser is restarted after this many pages, so memory does not creep.
VORA_BROWSER_RECYCLE_AFTER=200
# How long finished-run history is kept, in days (events / runs / per-page source history).
VORA_RETENTION_EVENT_DAYS=30
VORA_RETENTION_RUN_DAYS=90
VORA_RETENTION_HISTORY_DAYS=180
# Let the interactive pass fill and submit search/filter forms from the request (never
# login, payment, contact, upload, subscribe or CAPTCHA forms).
VORA_FORMS=true
# Same-site pages the interactive pass may follow from each page (one level deep).
VORA_CRAWL_PER_SITE=3
# Demote rows from page blocks (tables, card groups) that do not carry the request.
VORA_BLOCK_SUPPORT=true
# Shared knowledge of which sites give data or block (committed; see
# scripts/export_site_knowledge.py). Ranking uses it together with local history.
VORA_SITE_KNOWLEDGE=data/site_knowledge.json

# Official sites for requests that name none: a model suggests them, the program verifies them (keep the key here only).
GROQ_API_KEY=
# VORA_RESOLVER_MODELS=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite
# VORA_RESOLVER_SITES=3
# VORA_NETWORK_GUARD=true

# Optional: a self-hosted SearXNG instance for search (JSON format enabled), e.g. http://localhost:8080
# VORA_SEARXNG_URL=http://127.0.0.1:8080
# SEARXNG_SECRET=  (random hex; used by docker-compose.yml)
